' Builtin design-time native snapshots; no project code is constructed.
Private Function LayoutNativeKeyPart(value As String) As String
    Return String.From(String.Len(value)) + ":" + value
End Function

''' Platform-neutral description of one native control preview.
Public Class ControlSnapshotDescriptor
    ''' Native kind ("" when the control has no OS-drawn chrome).
    Public Property Kind As String = ""
    Public Property Title As String = ""
    Public Property Text As String = ""
    Public Property Placeholder As String = ""
    ''' Button state: -1 mixed, 0 off, 1 on.
    Public Property State As Integer = 0
    Public Property Minimum As Double = 0.0
    Public Property Maximum As Double = 100.0
    Public Property Value As Double = 0.0
    ''' Kind-specific switch: secure field, vertical slider or indeterminate bar.
    Public Property Flag As Boolean = False
    ''' NSDatePicker elements mask for the date kind.
    Public Property Elements As Integer = 0
    Public Property Items As Array Of String = []
    Public Property RowHeight As Double = 24.0
    Public Property Enabled As Boolean = True
    Public Property FontName As String = ""
    Public Property FontSize As Double = 0.0

    Public Function Key() As String
        Dim parts As String = LayoutNativeKeyPart(Me.Kind) + LayoutNativeKeyPart(Me.Title) + LayoutNativeKeyPart(Me.Text) + LayoutNativeKeyPart(Me.Placeholder) + "\t" + String.From(Me.State)
        parts += "\t" + String.From(Me.Minimum) + "\t" + String.From(Me.Maximum) + "\t" + String.From(Me.Value)
        parts += "\t" + String.From(Me.Flag) + "\t" + String.From(Me.Elements) + "\t" + String.From(Me.RowHeight)
        parts += "\t" + String.From(Me.Enabled) + LayoutNativeKeyPart(Me.FontName) + "\t" + String.From(Me.FontSize)
        For Each item As String In Me.Items
            parts += "\t" + LayoutNativeKeyPart(item)
        Next
        Return parts
    End Function
End Class

#If TargetMac Then
    Sequential Structure LayoutNativePoint
        X As Double
        Y As Double
    End Structure
    Sequential Structure LayoutNativeSize
        W As Double
        H As Double
    End Structure
    Sequential Structure LayoutNativeRect
        Origin As LayoutNativePoint
        Size As LayoutNativeSize
    End Structure

