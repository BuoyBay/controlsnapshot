' Scoped to a synchronous, UI-thread-only capture; no project code or event-loop
' pumping occurs while native controls send WM_CTLCOLOR messages to this parent.
Private Class LCWPaintContext
    Public Shared Property Brush As Ptr = Nil
    Public Shared Property Dark As Boolean = False
End Class
Private Function LCWWide(value As String) As Bytes
    Dim encoded As Bytes = value.AsUTF16LE()
    encoded.Append(0)
    encoded.Append(0)
    Return encoded
End Function
Private Function LCWParentMessage(widget As Ptr, message As UInt32, word As UInt64, param As Int64, id As UInt64, data As UInt64) As Int64
    If message >= 306 And message <= 312 Then
        Dim foreground As UInt32 = 2105376
        Dim background As UInt32 = 16777215
        If LCWPaintContext.Dark Then
            foreground = 15790320
            background = 2763306
        End If
        Dim dcAddress As Integer = word
        LCWTextColor(CType(dcAddress, Ptr), foreground)
        LCWBackground(CType(dcAddress, Ptr), background)
        Return CType(LCWPaintContext.Brush, Integer)
    End If
    Return LCWDefault(widget, message, word, param)
End Function
Private Function LCWWidget(cls As String, text As String, style As UInt32, parent As Ptr, x As Integer, y As Integer, w As Integer, h As Integer, font As Ptr, dark As Boolean) As Ptr
    Dim wideClass As Bytes = LCWWide(cls)
    Dim wideText As Bytes = LCWWide(text)
    ' WS_CHILD | WS_VISIBLE. The parent is never shown or activated.
    Dim widget As Ptr = LCWCreate(0, wideClass.DataPtr(), wideText.DataPtr(), style Or 1342177280, x, y, Math.Max(1, w), Math.Max(1, h), parent, Nil, Nil, Nil)
    If widget <> Nil Then
        LCWSend(widget, 48, CType(font, Integer), 0)
        Dim theme As String = "Explorer"
        If dark Then theme = "DarkMode_Explorer"
        Dim themeName As Bytes = LCWWide(theme)
        LCWTheme(widget, themeName.DataPtr(), Nil)
        ' Explorer's themed check/radio WM_PRINT paints white and ignores the
        ' parent's caption colors. Classic native buttons honor WM_CTLCOLOR.
        If dark And cls = "BUTTON" And (style = 4 Or style = 6) Then
            Dim classic As Bytes = LCWWide("")
            LCWTheme(widget, classic.DataPtr(), classic.DataPtr())
        End If
    End If
    Return widget
End Function
Private Function LCWBuild(spec As ControlSnapshotDescriptor, parent As Ptr, w As Integer, h As Integer, font As Ptr, dark As Boolean, scale As Double) As Ptr
    Dim cls As String = ""
    Dim text As String = spec.Text
    Dim style As UInt32 = 0
    Select Case spec.Kind
        Case "button", "checkbox", "radio"
            cls = "BUTTON"
            text = spec.Title
            If spec.Kind = "checkbox" Then style = 6
            If spec.Kind = "radio" Then style = 4
        Case "label"
            cls = "STATIC"
            style = 12
        Case "textfield", "search", "textarea", "date"
            cls = "EDIT"
            style = 8388736 ' WS_BORDER | ES_AUTOHSCROLL.
            If spec.Flag Then style = style Or 32
            If spec.Kind = "textarea" Then style = 10506308 ' Border, multiline, auto-vscroll, vertical scroll.
            If spec.Kind = "date" Then
                cls = "SysDateTimePick32"
                style = 0
                If spec.Elements = 236 Then cls = "STATIC"
            End If
        Case "popup", "combo"
            cls = "COMBOBOX"
            style = 2097155 ' WS_VSCROLL | CBS_DROPDOWNLIST.
            If spec.Kind = "combo" Then style = 2097154
        Case "slider"
            cls = "msctls_trackbar32"
            style = 16 ' TBS_NOTICKS.
            If spec.Flag Then style = style Or 2
        Case "progress"
            cls = "msctls_progress32"
        Case "stepper"
            cls = "msctls_updown32"
        Case "tabs"
            cls = "SysTabControl32"
        Case "list"
            cls = "SysListView32"
            style = 8388609 ' WS_BORDER | LVS_REPORT.
        Case "radiogroup", "segments"
            cls = "STATIC"
        Case Else
            Return Nil
    End Select
    Dim widget As Ptr = LCWWidget(cls, text, style, parent, 0, 0, w, h, font, dark)
    If widget = Nil Then Return Nil
    If spec.Kind = "radiogroup" Or spec.Kind = "segments" Or spec.Kind = "date" Then LCWSubclass(widget, AddressOf LCWParentMessage, 1, 0)
    If Not spec.Enabled Then LCWEnable(widget, 0)
    Select Case spec.Kind
        Case "checkbox", "radio"
            Dim state As Integer = Math.Max(0, spec.State)
            If spec.State < 0 Then state = 2
            LCWSend(widget, 241, state, 0)
        Case "textfield", "search"
            Dim placeholder As Bytes = LCWWide(spec.Placeholder)
            LCWSend(widget, 5377, 0, CType(placeholder.DataPtr(), Integer))
        Case "popup", "combo"
            For Each title As String In spec.Items
                Dim item As Bytes = LCWWide(title)
                LCWSend(widget, 323, 0, CType(item.DataPtr(), Integer))
            Next
            If spec.Kind = "popup" Then LCWSend(widget, 334, 0, 0)
        Case "slider", "progress", "stepper"
            ' Win32 ranges are integral; normalize the Double API just as the
            ' runtime does, preserving fractional values and large endpoints.
            Dim lo As Integer = 0
            Dim hi As Integer = 10000
            Dim fraction As Double = 0.0
            If spec.Maximum > spec.Minimum Then fraction = (spec.Value - spec.Minimum) / (spec.Maximum - spec.Minimum)
            Dim current As Integer = Math.Round(Math.Max(0.0, Math.Min(1.0, fraction)) * 10000.0)
            If spec.Kind = "slider" Then
                LCWSend(widget, 1031, 0, lo)
                LCWSend(widget, 1032, 0, hi)
                LCWSend(widget, 1029, 1, current)
            ElseIf spec.Kind = "progress" Then
                ' Themed progress bars animate increasing positions. A one-unit
                ' overshoot followed by a decrease commits the position immediately;
                ' restore the real maximum before WM_PRINT (including the full case).
                LCWSend(widget, 1030, lo, hi + 1)
                If spec.Flag Then current = lo + (hi - lo) * 0.4
                LCWSend(widget, 1026, current + 1, 0)
                LCWSend(widget, 1026, current, 0)
                LCWSend(widget, 1030, lo, hi)
            Else
                LCWSend(widget, 1135, lo, hi)
                LCWSend(widget, 1137, 0, current)
            End If
        Case "tabs"
            For i As Integer = 0 To Array.LastIndex(spec.Items)
                Dim title As Bytes = LCWWide(spec.Items(i))
                Dim item As LCWTabItem
                item.Mask = 1
                item.Text = title.DataPtr()
                LCWSend(widget, 4926, i, CType(CType(item, Ptr), Integer))
            Next
        Case "list"
            If dark Then
                LCWSend(widget, 4097, 0, 2763306) ' LVM_SETBKCOLOR.
                LCWSend(widget, 4132, 0, 15790320) ' LVM_SETTEXTCOLOR.
                LCWSend(widget, 4134, 0, 2763306) ' LVM_SETTEXTBKCOLOR.
            End If
            Dim title As Bytes = LCWWide(spec.Title)
            Dim column As LCWColumn
            column.Mask = 6
            column.Width = Math.Max(20, w - 4)
            column.Text = title.DataPtr()
            LCWSend(widget, 4193, 0, CType(CType(column, Ptr), Integer))
        Case "date"
            If spec.Elements = 236 Then
                Dim split As Integer = Math.Round(w * 0.6)
                Dim dateWidget As Ptr = LCWWidget("SysDateTimePick32", "", 0, widget, 0, 0, split, h, font, dark)
                Dim timeWidget As Ptr = LCWWidget("SysDateTimePick32", "", 9, widget, split, 0, w - split, h, font, dark)
                LCWSetDate(dateWidget, "yyyy-MM-dd")
                LCWSetDate(timeWidget, "HH:mm")
                If Not spec.Enabled Then
                    LCWEnable(dateWidget, 0)
                    LCWEnable(timeWidget, 0)
                End If
            Else
                Dim format As String = "yyyy-MM-dd"
                If spec.Elements = 12 Then format = "HH:mm"
                LCWSetDate(widget, format)
            End If
        Case "radiogroup", "segments"
            For i As Integer = 0 To Array.LastIndex(spec.Items)
                Dim x As Integer = 0
                Dim y As Integer = Math.Round(i * 22.0 * scale)
                Dim cw As Integer = w
                Dim ch As Integer = Math.Round(22.0 * scale)
                Dim buttonStyle As UInt32 = 4
                If spec.Kind = "segments" Then
                    cw = w \ Math.Max(1, Array.Count(spec.Items))
                    x = i * cw
                    y = 0
                    ch = h
                    buttonStyle = 4099 ' BS_PUSHLIKE | BS_AUTOCHECKBOX.
                End If
                Dim child As Ptr = LCWWidget("BUTTON", spec.Items(i), buttonStyle, widget, x, y, cw, ch, font, dark)
                If Not spec.Enabled Then LCWEnable(child, 0)
                If (spec.Kind = "radiogroup" And i = 0) Or (spec.Kind = "segments" And i = spec.State) Then LCWSend(child, 241, 1, 0)
            Next
    End Select
    Return widget
End Function
Private Sub LCWSetDate(widget As Ptr, format As String)
    If widget = Nil Then Return
    Dim dateValue As LCWDate = { Year: 2026, Month: 1, DayOfWeek: 4, Day: 1, Hour: 9, Minute: 41, Second: 0, Millisecond: 0 }
    LCWSend(widget, 4098, 0, CType(CType(dateValue, Ptr), Integer))
    Dim formatText As Bytes = LCWWide(format)
    LCWSend(widget, 4146, 0, CType(formatText.DataPtr(), Integer))
End Sub
Private Function LCWRender(spec As ControlSnapshotDescriptor, w As Double, h As Double, dark As Boolean, scale As Double) As Picture
    Dim init As LCWCommonControls = { Size: 8, Classes: 65535 }
    LCWInit(CType(init, Ptr))
    Dim pw As Integer = Math.Ceiling(w * scale)
    Dim ph As Integer = Math.Ceiling(h * scale)
    Dim cls As Bytes = LCWWide("STATIC")
    Dim empty As Bytes = LCWWide("")
    Dim host As Ptr = LCWCreate(134217856, cls.DataPtr(), empty.DataPtr(), 2147483648, 0, 0, pw, ph, Nil, Nil, Nil, Nil)
    If host = Nil Then Return Nil
    Dim dc As Ptr = Nil
    Dim memory As Ptr = Nil
    Dim bitmap As Ptr = Nil
    Dim previous As Ptr = Nil
    Dim brush As Ptr = Nil
    Dim font As Ptr = Nil
    Try
        Dim background As UInt32 = 16777215
        If dark Then background = 2763306
        brush = LCWBrush(background)
        LCWPaintContext.Brush = brush
        LCWPaintContext.Dark = dark
        LCWSubclass(host, AddressOf LCWParentMessage, 1, 0)
        Dim name As String = spec.FontName
        If name = "" Then name = "Segoe UI"
        Dim family As Bytes = LCWWide(name)
        Dim points As Double = spec.FontSize
        If points <= 0.0 Then points = 9.0
        font = LCWFont(-Math.Round(points * scale * 96.0 / 72.0), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 5, 0, family.DataPtr())
        Dim widget As Ptr = LCWBuild(spec, host, pw, ph, font, dark, scale)
        If widget = Nil Then Return Nil
        dc = LCWDC(host)
        memory = LCWMemoryDC(dc)
        If memory = Nil Then Return Nil
        Dim info As LCWBitmapInfo
        info.Size = 40
        info.Width = pw
        info.Height = -ph ' Top-down BGRA.
        info.Planes = 1
        info.Bits = 32
        Dim pixels As Ptr = Nil
        bitmap = LCWDIB(memory, CType(info, Ptr), 0, pixels, Nil, 0)
        If bitmap = Nil Or pixels = Nil Then Return Nil
        previous = LCWSelect(memory, bitmap)
        Dim oldBrush As Ptr = LCWSelect(memory, brush)
        LCWFill(memory, 0, 0, pw, ph, 15728673) ' PATCOPY.
        LCWSelect(memory, oldBrush)
        LCWSend(widget, 791, CType(memory, Integer), 30) ' WM_PRINT: nonclient/client/erase/children; no CHECKVISIBLE.
        LCWFlush() ' Finish batched GDI drawing before reading DIB pixels on the CPU.
        Dim rgba As New Bytes(pw * ph * 4)
        rgba.Append(pixels, pw * ph * 4)
        For i As Integer = 0 To rgba.Count - 1 Step 4
            Dim blue As Integer = rgba.Item(i)
            rgba.SetItem(i, rgba.Item(i + 2))
            rgba.SetItem(i + 2, blue)
            rgba.SetItem(i + 3, 255) ' GDI writes no alpha; background is part of this snapshot.
        Next
        Return Picture.FromBuffer(rgba.DataPtr(), rgba.Count, 0, pw, ph)
    Finally
        If previous <> Nil Then LCWSelect(memory, previous)
        If bitmap <> Nil Then LCWDelete(bitmap)
        If memory <> Nil Then LCWDeleteDC(memory)
        If dc <> Nil Then LCWReleaseDC(host, dc)
        LCWDestroy(host)
        If font <> Nil Then LCWDelete(font)
        If brush <> Nil Then LCWDelete(brush)
        LCWPaintContext.Brush = Nil
    End Try
End Function
#End If

' Native appearance context is part of render identity; position is not.
Public Function AppearanceKey() As String
    #If TargetLinux Then
        Return LCGSetting("gtk-theme-name") + "\n" + LCGSetting("gtk-font-name") + "\n" + System.EnvironmentVariable("GTK_THEME").Or("")
    #ElseIf TargetWindows Then
        Return String.From(LCWSysColor(15)) + ":" + String.From(LCWSysColor(8)) + ":" + String.From(LCWSysColor(13))
    #ElseIf TargetMac Then
        Dim accent As Ptr = LCNConvertColor(LCNAccent(LCNClass("NSColor")), LCNDeviceRGB(LCNClass("NSColorSpace")))
        Dim key As String = ""
        If accent <> Nil Then key = String.From(LCNRed(accent)) + ":" + String.From(LCNGreen(accent)) + ":" + String.From(LCNBlue(accent))
        Return key + ":" + String.From(LCNContrast(LCNWorkspace(LCNClass("NSWorkspace"))))
    #End If
End Function
#If TargetLinux Then
Private Optional Declare Function LCGSettings Lib "libgtk-4.so.1" Alias "gtk_settings_get_default" () As Ptr
Private Optional Declare Sub LCGGetSetting Lib "libgobject-2.0.so.0" Alias "g_object_get" (obj As Ptr, name As String, ByRef value As CString, finish As Ptr)
Private Optional Declare Sub LCGFree Lib "libglib-2.0.so.0" Alias "g_free" (value As Ptr)
Private Function LCGSetting(name As String) As String
    If LCGInit() = 0 Then Return ""
    Dim value As CString = Nil
    LCGGetSetting(LCGSettings(), name, value, Nil)
    If value = Nil Then Return ""
    Try
        Return CType(value, String)
    Finally
        LCGFree(value)
    End Try
End Function
#ElseIf TargetWindows Then
Private Optional Declare Function LCWSysColor Lib "user32" Alias "GetSysColor" (index As Int32) As UInt32
#End If

Public Function BackingScale() As Double
        Dim backing As Double = 1.0
        #If TargetMac Then
            Dim screen As Ptr = LCNMainScreen(LCNClass("NSScreen"))
            If screen <> Nil Then backing = Math.Max(1.0, LCNBackingScale(screen))
        #End If
        Return backing
    End Function


''' Detached result. Status is "rendered", "unsupported", "invalid-request" or "failed".
Public Class ControlSnapshotOutcome
    Public Property Image As Picture = Nil
    Public Property Status As String = "unsupported"
    Public Property Message As String = ""
End Class

''' Position-independent visual identity; callers own caching and invalidation.
Public Function CacheKey(spec As ControlSnapshotDescriptor, w As Double, h As Double, dark As Boolean, scale As Double) As String
    Dim appearance As String = "light"
    If dark Then appearance = "dark"
    Return spec.Key() + "\n" + String.From(w) + "x" + String.From(h) + "\n" + appearance + "\n" + String.From(scale)
End Function

Public Function TryRender(spec As ControlSnapshotDescriptor, w As Double, h As Double, scale As Double, dark As Boolean) As ControlSnapshotOutcome
    Dim outcome As New ControlSnapshotOutcome()
    If spec = Nil Then Return outcome
    Select Case spec.Kind
        Case "button", "checkbox", "radio", "radiogroup", "label", "textfield", "search", "combo", "popup", "date", "slider", "progress", "stepper", "segments", "tabs", "list", "textarea", "disclosure"
        Case Else
            Return outcome
    End Select
    If Not (w >= 1.0 And h >= 1.0 And scale > 0.0 And scale <= 8.0 And spec.FontSize >= 0.0 And spec.FontSize <= 1000.0) Then
        outcome.Status = "invalid-request"
        Return outcome
    End If
    If Not (Math.Ceiling(w * scale) <= 32767.0 And Math.Ceiling(h * scale) <= 32767.0 And Math.Ceiling(w * scale) * Math.Ceiling(h * scale) <= 16777216.0) Then
        outcome.Status = "invalid-request"
        Return outcome
    End If
    outcome.Status = "failed"
    Try
        #If TargetMac Then
            Dim png As Bytes = LCNRender(spec, w, h, dark, scale)
            If png <> Nil Then outcome.Image = Picture.FromPNG(png)
        #ElseIf TargetLinux Then
            outcome.Image = LCGRender(spec, w, h, dark, scale)
        #ElseIf TargetWindows Then
            If spec.Kind = "disclosure" Then
                outcome.Status = "unsupported"
                Return outcome
            End If
            outcome.Image = LCWRender(spec, w, h, dark, scale)
            If dark And outcome.Image <> Nil Then
                Select Case spec.Kind
                    Case "date", "tabs"
                        outcome.Message = "Win32 dark appearance fallback: native date/tab surfaces remain light."
                    Case "list"
                        outcome.Message = "Win32 partial dark appearance: list body is dark; native header can remain light."
                    Case "combo", "popup"
                        outcome.Message = "Win32 partial dark appearance: native combo surface can remain light."
                End Select
            End If
        #End If
        If outcome.Image <> Nil Then outcome.Status = "rendered"
    Catch e As Exception
        outcome.Message = e.Message
    End Try
    Return outcome
End Function

''' Convenience form: Nil for any non-rendered outcome; TryRender explains why.
Public Function Render(spec As ControlSnapshotDescriptor, w As Double, h As Double, scale As Double, dark As Boolean) As Picture
    Return TryRender(spec, w, h, scale, dark).Image
End Function
