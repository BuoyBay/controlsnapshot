    Private Function LCNText(value As String) As Ptr
        Return LCNString(LCNClass("NSString"), value)
    End Function

    Private Function LCNFrame(x As Double, y As Double, w As Double, h As Double) As LayoutNativeRect
        Dim frame As LayoutNativeRect = { Origin: { X: x, Y: y }, Size: { W: w, H: h } }
        Return frame
    End Function

    ' Owned (+1) view of the given AppKit class.
    Private Function LCNView(className As String, w As Double, h As Double) As Ptr
        Dim cls As Ptr = LCNClass(className)
        If cls = Nil Then Return Nil
        Return LCNInitFrame(LCNAlloc(cls), LCNFrame(0.0, 0.0, w, h))
    End Function

    Private Function LCNButton(kind As Integer, bezel As Integer, title As String, w As Double, h As Double) As Ptr
        Dim button As Ptr = LCNView("NSButton", w, h)
        If button = Nil Then Return Nil
        LCNSetButtonType(button, kind)
        If bezel > 0 Then LCNSetBezelStyle(button, bezel)
        LCNSetTitle(button, LCNText(title))
        Return button
    End Function

    ' Builds the owned root view for a spec, or Nil when AppKit lacks the class.
    Private Function LCNBuild(spec As ControlSnapshotDescriptor, w As Double, h As Double) As Ptr
        ' AppKit constants: NSButtonTypeSwitch 3, Radio 4, PushOnPushOff 1,
        ' MomentaryPushIn 7; NSBezelStylePush 1, Disclosure 5; NSBezelBorder 2.
        Dim view As Ptr = Nil
        Select Case spec.Kind
            Case "button"
                view = LCNButton(7, 1, spec.Title, w, h)
            Case "checkbox"
                view = LCNButton(3, 0, spec.Title, w, h)
                If view <> Nil Then
                    LCNSetAllowsMixed(view, True)
                    LCNSetState(view, spec.State)
                End If
            Case "radio"
                view = LCNButton(4, 0, spec.Title, w, h)
                If view <> Nil Then LCNSetState(view, spec.State)
            Case "radiogroup"
                view = LCNView("NSView", w, h)
                If view <> Nil Then
                    For index As Integer = 0 To Array.LastIndex(spec.Items)
                        ' Unflipped container: the first option sits at the top.
                        Dim radio As Ptr = LCNButton(4, 0, spec.Items(index), w, 20.0)
                        If radio = Nil Then Continue For
                        LCNSetFrame(radio, LCNFrame(0.0, h - 22.0 * (index + 1) + 1.0, w, 20.0))
                        If index = 0 Then LCNSetState(radio, 1)
                        LCNAddSubview(view, radio)
                        LCNRelease(radio)
                    Next
                End If
            Case "disclosure"
                view = LCNButton(1, 5, "", w, h)
                If view <> Nil Then LCNSetState(view, spec.State)
            Case "label"
                view = LCNView("NSTextField", w, h)
                If view <> Nil Then
                    LCNSetBezeled(view, False)
                    LCNSetBordered(view, False)
                    LCNSetDrawsBackground(view, False)
                    LCNSetEditable(view, False)
                    LCNSetStringValue(view, LCNText(spec.Text))
                End If
            Case "textfield", "search", "combo"
                Dim className As String = "NSTextField"
                If spec.Kind = "search" Then className = "NSSearchField"
                If spec.Kind = "combo" Then className = "NSComboBox"
                If spec.Flag Then className = "NSSecureTextField"
                view = LCNView(className, w, h)
                If view <> Nil Then
                    LCNSetStringValue(view, LCNText(spec.Text))
                    If spec.Placeholder <> "" Then LCNSetPlaceholder(view, LCNText(spec.Placeholder))
                End If
            Case "popup"
                Dim cls As Ptr = LCNClass("NSPopUpButton")
                If cls <> Nil Then
                    view = LCNInitPopup(LCNAlloc(cls), LCNFrame(0.0, 0.0, w, h), False)
                    For Each item As String In spec.Items
                        LCNAddItemTitle(view, LCNText(item))
                    Next
                End If
            Case "date"
                view = LCNView("NSDatePicker", w, h)
                If view <> Nil Then
                    LCNSetDatePickerStyle(view, 0)
                    LCNSetDatePickerElements(view, spec.Elements)
                    LCNSetTimeZone(view, LCNTimeZoneOffset(LCNClass("NSTimeZone"), 0))
                    ' 2026-01-01 09:41 UTC: a fixed sample, never the clock.
                    LCNSetDateValue(view, LCNDateSinceReference(LCNClass("NSDate"), 788953260.0))
                End If
            Case "slider", "progress", "stepper"
                Dim className As String = "NSSlider"
                If spec.Kind = "progress" Then className = "NSProgressIndicator"
                If spec.Kind = "stepper" Then className = "NSStepper"
                view = LCNView(className, w, h)
                If view <> Nil Then
                    If spec.Kind = "progress" Then
                        LCNSetIndicatorStyle(view, 0)
                        LCNSetIndeterminate(view, spec.Flag)
                    End If
                    If spec.Kind = "slider" Then LCNSetVertical(view, spec.Flag)
                    LCNSetMinValue(view, spec.Minimum)
                    LCNSetMaxValue(view, spec.Maximum)
                    LCNSetDoubleValue(view, spec.Value)
                End If
            Case "segments"
                view = LCNView("NSSegmentedControl", w, h)
                If view <> Nil Then
                    LCNSetSegmentCount(view, Array.Count(spec.Items))
                    For index As Integer = 0 To Array.LastIndex(spec.Items)
                        LCNSetSegmentLabel(view, LCNText(spec.Items(index)), index)
                    Next
                    LCNSetSelectedSegment(view, spec.State)
                    ' NSSegmentDistributionFillEqually = 2: segments share the frame.
                    LCNSetSegmentDistribution(view, 2)
                End If
            Case "tabs"
                ' Detached NSTabView never lays out its tab strip, so compose the
                ' same pieces AppKit uses: a borderless-tab bezel body and a
                ' segmented control straddling its top edge.
                view = LCNView("NSView", w, h)
                Dim segments As Ptr = LCNView("NSSegmentedControl", w, 24.0)
                Dim body As Ptr = Nil
                If segments <> Nil Then
                    LCNSetSegmentCount(segments, Array.Count(spec.Items))
                    For index As Integer = 0 To Array.LastIndex(spec.Items)
                        LCNSetSegmentLabel(segments, LCNText(spec.Items(index)), index)
                    Next
                    LCNSetSelectedSegment(segments, 0)
                    LCNSizeToFit(segments)
                    Dim strip As LayoutNativeRect = LCNGetFrame(segments)
                    Dim stripW As Double = Math.Min(w, strip.Size.W)
                    Dim stripH As Double = Math.Min(h, strip.Size.H)
                    ' NSNoTabsBezelBorder = 4; the body's top edge meets the strip's middle.
                    body = LCNView("NSTabView", w, Math.Max(1.0, h - stripH / 2.0))
                    If view <> Nil And body <> Nil Then
                        LCNSetTabViewType(body, 4)
                        LCNAddSubview(view, body)
                        LCNSetFrame(segments, LCNFrame(Math.Floor((w - stripW) / 2.0), h - stripH, stripW, stripH))
                        LCNAddSubview(view, segments)
                    End If
                    LCNRelease(segments)
                End If
                If body <> Nil Then LCNRelease(body)
            Case "textarea", "list"
                view = LCNView("NSScrollView", w, h)
                If view <> Nil Then
                    LCNSetBorderType(view, 2)
                    LCNSetHasVerticalScroller(view, True)
                    Dim content As LayoutNativeSize = LCNContentSize(view)
                    Dim document As Ptr = Nil
                    If spec.Kind = "textarea" Then
                        document = LCNView("NSTextView", content.W, content.H)
                        If document <> Nil Then LCNSetString(document, LCNText(spec.Text))
                    Else
                        document = LCNView("NSTableView", content.W, content.H)
                        Dim columnClass As Ptr = LCNClass("NSTableColumn")
                        If document <> Nil And columnClass <> Nil Then
                            Dim column As Ptr = LCNInitIdentifier(LCNAlloc(columnClass), LCNText("column"))
                            LCNSetColumnTitle(column, LCNText(spec.Title))
                            LCNSetColumnWidth(column, Math.Max(20.0, content.W - 4.0))
                            LCNAddTableColumn(document, column)
                            LCNRelease(column)
                            LCNSetRowHeight(document, Math.Max(8.0, spec.RowHeight))
                            LCNSetAlternating(document, True)
                        End If
                    End If
                    If document <> Nil Then
                        LCNSetDocumentView(view, document)
                        LCNRelease(document)
                    End If
                End If
        End Select
        Return view
    End Function

    Private Sub LCNApplyVisuals(view As Ptr, spec As ControlSnapshotDescriptor)
        If LCNResponds(view, LCNSelector("setEnabled:")) Then LCNEnabled(view, spec.Enabled)
        If (spec.FontName <> "" Or spec.FontSize > 0.0) And LCNResponds(view, LCNSelector("setFont:")) Then
            Dim size As Double = spec.FontSize
            If size <= 0.0 Then size = 13.0
            Dim font As Ptr = Nil
            If spec.FontName <> "" Then font = LCNNamedFont(LCNClass("NSFont"), LCNText(spec.FontName), size)
            If font = Nil Then font = LCNSystemFont(LCNClass("NSFont"), size)
            LCNFont(view, font)
        End If
        Dim children As Ptr = LCNSubviews(view)
        For i As Integer = 0 To LCNCount(children) - 1
            LCNApplyVisuals(LCNAt(children, i), spec)
        Next
    End Sub

    ' Encoded PNG of the spec drawn by AppKit, or Nil.
    Private Function LCNRender(spec As ControlSnapshotDescriptor, w As Double, h As Double, dark As Boolean, scale As Double) As Bytes
        LCNApplication(LCNClass("NSApplication"))
        Dim priorAppearance As Ptr = LCNCurrentAppearance(LCNClass("NSAppearance"))
        Dim view As Ptr = Nil
        Dim host As Ptr = Nil
        Dim png As Bytes = Nil
        Try
            Dim appearanceName As String = "NSAppearanceNameAqua"
            If dark Then appearanceName = "NSAppearanceNameDarkAqua"
            Dim appearance As Ptr = LCNAppearanceNamed(LCNClass("NSAppearance"), LCNText(appearanceName))
            If appearance <> Nil Then LCNCurrentSet(LCNClass("NSAppearance"), appearance)
            view = LCNBuild(spec, w, h)
            If view = Nil Then Return Nil
            ' A never-shown host gives modern AppKit cells window/appearance context.
            host = LCNWindowInit(LCNAlloc(LCNClass("NSWindow")), LCNFrame(0.0, 0.0, w, h), 0, 2, False)
            If host = Nil Then Return Nil
            If appearance <> Nil Then
                LCNSetAppearance(host, appearance)
                LCNSetAppearance(view, appearance)
            End If
            LCNWindowContent(host, view)
            LCNApplyVisuals(view, spec)
            LCNLayoutSubtree(view)
            Dim pixelsWide As Integer = Math.Max(1, Math.Ceiling(w * scale))
            Dim pixelsHigh As Integer = Math.Max(1, Math.Ceiling(h * scale))
            Dim rep As Ptr = LCNInitBitmap(LCNAlloc(LCNClass("NSBitmapImageRep")), Nil, pixelsWide, pixelsHigh, 8, 4, True, False, LCNText("NSDeviceRGBColorSpace"), 0, 0)
            If rep <> Nil Then
                Try
                    ' cacheDisplay leaves transparent pixels untouched: initialize them.
                    LCNZero(LCNBitmapData(rep), 0, LCNBitmapStride(rep) * pixelsHigh)
                    Dim size As LayoutNativeSize = { W: w, H: h }
                    LCNSetImageSize(rep, size)
                    LCNCacheDisplay(view, LCNFrame(0.0, 0.0, w, h), rep)
                    Dim data As Ptr = LCNImageData(rep, 4, LCNEmptyDictionary(LCNClass("NSDictionary")))
                    If data <> Nil Then
                        Dim length As Integer = LCNDataLength(data)
                        If length > 0 Then
                            png = New Bytes(length)
                            png.Append(LCNDataBytes(data), length)
                        End If
                    End If
                Finally
                    LCNRelease(rep)
                End Try
            End If
        Finally
            If view <> Nil Then LCNRelease(view)
            If host <> Nil Then LCNRelease(host)
            LCNCurrentSet(LCNClass("NSAppearance"), priorAppearance)
        End Try
        Return png
    End Function

#End If

' Renderer-value readers: typed literal key, else the exact source expression.
#If TargetLinux Then
' Snapshot native children directly, not the desktop. A transparent, non-presented
' host provides a GTK native renderer. Explicit allocation avoids pumping the main
' loop (and reentering editor callbacks) from inside Canvas.Paint.
Private Optional Declare Function LCGInit Lib "libgtk-4.so.1" Alias "gtk_init_check" () As Int32
Private Optional Declare Function LCGWindow Lib "libgtk-4.so.1" Alias "gtk_window_new" () As Ptr
Private Optional Declare Sub LCGDecorated Lib "libgtk-4.so.1" Alias "gtk_window_set_decorated" (widget As Ptr, flag As Int32)
Private Optional Declare Sub LCGOpacity Lib "libgtk-4.so.1" Alias "gtk_widget_set_opacity" (widget As Ptr, opacity As Double)
Private Optional Declare Sub LCGChild Lib "libgtk-4.so.1" Alias "gtk_window_set_child" (widget As Ptr, child As Ptr)
Private Optional Declare Sub LCGVisible Lib "libgtk-4.so.1" Alias "gtk_widget_set_visible" (widget As Ptr, flag As Int32)
Private Optional Declare Sub LCGAllocate Lib "libgtk-4.so.1" Alias "gtk_widget_allocate" (widget As Ptr, width As Int32, height As Int32, baseline As Int32, transform As Ptr)
Private Optional Declare Sub LCGDestroy Lib "libgtk-4.so.1" Alias "gtk_window_destroy" (widget As Ptr)
Private Optional Declare Function LCGSnapshot Lib "libgtk-4.so.1" Alias "gtk_snapshot_new" () As Ptr
Private Optional Declare Sub LCGSnapshotChild Lib "libgtk-4.so.1" Alias "gtk_widget_snapshot_child" (parent As Ptr, child As Ptr, snapshot As Ptr)
Private Optional Declare Sub LCGSnapshotScale Lib "libgtk-4.so.1" Alias "gtk_snapshot_scale" (snapshot As Ptr, sx As Single, sy As Single)
Private Optional Declare Function LCGNode Lib "libgtk-4.so.1" Alias "gtk_snapshot_free_to_node" (snapshot As Ptr) As Ptr
