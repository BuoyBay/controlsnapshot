    Y As Single
    W As Single
    H As Single
End Structure

Private Function LCGFlag(value As Boolean) As Int32
    If value Then Return 1
    Return 0
End Function

Private Function LCGBuild(spec As ControlSnapshotDescriptor) As Ptr
    Dim widget As Ptr = Nil
    Select Case spec.Kind
        Case "button"
            widget = LCGButton(spec.Title)
        Case "checkbox", "radio"
            widget = LCGCheck(spec.Title)
            LCGCheckActive(widget, LCGFlag(spec.State = 1))
            LCGCheckMixed(widget, LCGFlag(spec.State = -1))
            If spec.Kind = "radio" Then
                Dim group As Ptr = LCGCheck("")
                LCGRefSink(group)
                LCGCheckGroup(widget, group)
                LCGUnref(group)
            End If
        Case "radiogroup", "segments"
            Dim orientation As Int32 = 1
            If spec.Kind = "segments" Then orientation = 0
            widget = LCGBox(orientation, 0)
            If spec.Kind = "segments" Then LCGClass(widget, "linked")
            Dim group As Ptr = Nil
            For i As Integer = 0 To Array.LastIndex(spec.Items)
                Dim option As Ptr = Nil
                If spec.Kind = "segments" Then
                    option = LCGToggle(spec.Items(i))
                    LCGToggleActive(option, LCGFlag(i = spec.State))
                    LCGExpand(option, 1)
                Else
                    option = LCGCheck(spec.Items(i))
                    If group <> Nil Then LCGCheckGroup(option, group)
                    If group = Nil Then group = option
                    LCGCheckActive(option, LCGFlag(i = 0))
                End If
                LCGAppend(widget, option)
            Next
        Case "label"
            widget = LCGLabel(spec.Text)
            LCGAlign(widget, 0.0)
        Case "date"
            widget = LCGMenuButton()
            Dim display As String = "2026-01-01 09:41"
            If spec.Elements = 224 Then display = "2026-01-01"
            If spec.Elements = 12 Then display = "09:41"
            LCGMenuLabel(widget, display)
        Case "textfield", "search", "combo"
            widget = LCGEntry()
            If spec.Kind = "search" Then
                LCGRefSink(widget)
                LCGUnref(widget)
                widget = LCGSearch()
            ElseIf spec.Kind = "combo" Then
                LCGRefSink(widget)
                LCGUnref(widget)
                widget = LCGCombo()
            End If
            Dim entry As Ptr = widget
            If spec.Kind = "combo" Then entry = LCGComboChild(widget)
            LCGText(entry, spec.Text)
            If spec.Kind <> "search" Then
                LCGPlaceholder(entry, spec.Placeholder)
                LCGPassword(entry, LCGFlag(Not spec.Flag))
            End If
        Case "popup"
            Dim model As Ptr = LCGStrings(Nil)
            For Each title As String In spec.Items
                LCGStringAppend(model, title)
            Next
            widget = LCGDropdown(model, Nil)
            ' gtk_drop_down_new takes ownership of the model.
        Case "stepper"
            widget = LCGBox(1, 0)
            LCGClass(widget, "linked")
            Dim up As Ptr = LCGIconButton("pan-up-symbolic")
            Dim down As Ptr = LCGIconButton("pan-down-symbolic")
            LCGIconSize(LCGButtonChild(up), 8)
            LCGIconSize(LCGButtonChild(down), 8)
            LCGAppend(widget, up)
            LCGAppend(widget, down)
        Case "slider"
            Dim maximum As Double = Math.Max(spec.Minimum + 1.0, spec.Maximum)
            widget = LCGScale(LCGFlag(spec.Flag), spec.Minimum, maximum, 1.0)
            LCGDrawValue(widget, 0)
            LCGRangeValue(widget, spec.Value)
        Case "progress"
            widget = LCGProgress()
            Dim fraction As Double = (spec.Value - spec.Minimum) / Math.Max(1.0, spec.Maximum - spec.Minimum)
            If spec.Flag Then fraction = 0.4
            LCGFraction(widget, Math.Max(0.0, Math.Min(1.0, fraction)))
            LCGVExpand(widget, 1)
            LCGVAlign(widget, 3) ' GTK_ALIGN_CENTER; retain natural trough height.
            Dim progress As Ptr = widget
            widget = LCGBox(1, 0)
            LCGAppend(widget, progress)
        Case "tabs"
            widget = LCGNotebook()
            For Each title As String In spec.Items
                LCGPage(widget, LCGBox(1, 0), LCGLabel(title))
            Next
        Case "textarea", "list"
            widget = LCGScroll()
            LCGScrollFrame(widget, 1)
            Dim content As Ptr = Nil
            If spec.Kind = "textarea" Then
                content = LCGTextView()
                LCGBufferText(LCGBuffer(content), spec.Text, -1)
            Else
                content = LCGColumnView(Nil)
                Dim column As Ptr = LCGColumn(spec.Title, Nil)
                LCGColumnAppend(content, column)
                LCGUnref(column)
            End If
            LCGScrollChild(widget, content)
        Case "disclosure"
            widget = LCGExpander(Nil)
            LCGExpanded(widget, LCGFlag(spec.State = 1))
    End Select
    If widget <> Nil Then LCGSensitive(widget, LCGFlag(spec.Enabled))
    Return widget
End Function

Private Sub LCGApplyStyle(widget As Ptr, theme As Ptr, font As Ptr)
    ' Snapshot controls never participate in keyboard focus, including entry internals.
    LCGFocusable(widget, 0)
    LCGStyleProvider(LCGStyle(widget), theme, 600)
    If font <> Nil Then LCGStyleProvider(LCGStyle(widget), font, 601)
    Dim child As Ptr = LCGFirst(widget)
    While child <> Nil
        LCGApplyStyle(child, theme, font)
        child = LCGNext(child)
    End While
End Sub

Private Function LCGRender(spec As ControlSnapshotDescriptor, w As Double, h As Double, dark As Boolean, scale As Double) As Picture
    If LCGInit() = 0 Then Return Nil
    Dim widget As Ptr = LCGBuild(spec)
    If widget = Nil Then Return Nil
    LCGRefSink(widget)
    Dim host As Ptr = LCGWindow()
    Dim theme As Ptr = LCGProvider()
    Dim font As Ptr = Nil
    Dim node As Ptr = Nil
    Dim texture As Ptr = Nil
    Dim data As Ptr = Nil
    Try
        Dim variant As Ptr = Nil
        Dim variantName As String = "dark"
        If dark Then variant = CType(variantName, Ptr)
        Dim themeName As String = LCGSetting("gtk-theme-name")
        If themeName = "" Then themeName = "Adwaita"
        LCGTheme(theme, themeName, variant)
        If spec.FontName <> "" Or spec.FontSize > 0.0 Or spec.Kind = "stepper" Then
            Dim css As String = "* {"
            ' CSS quoted strings: never allow source text to become CSS syntax.
            Dim fontValue As JSONItem = JSONItem.NewObject()
            fontValue.Value("name") = spec.FontName
            If spec.FontName <> "" Then css += "font-family: " + Json.Stringify(fontValue.Value("name")) + ";"
            If spec.FontSize > 0.0 Then css += "font-size: " + String.From(spec.FontSize) + "pt;"
            If spec.Kind = "stepper" Then css += "min-height: 0; min-width: 0; padding: 0;"
            css += "}"
            font = LCGProvider()
            LCGCSS(font, css, -1)
        End If
        LCGDecorated(host, 0)
        LCGOpacity(host, 0.0)
        LCGChild(host, widget)
        LCGApplyStyle(host, theme, font)
        LCGVisible(host, 1)
        LCGWindowFocus(host, Nil)
        If spec.Kind = "textfield" Or spec.Kind = "search" Then LCGSelectRegion(widget, 0, 0)
        If spec.Kind = "combo" Then LCGSelectRegion(LCGComboChild(widget), 0, 0)
        LCGAllocate(host, Math.Ceiling(w), Math.Ceiling(h), -1, Nil)
        Dim snapshot As Ptr = LCGSnapshot()
        LCGSnapshotScale(snapshot, scale, scale)
        LCGSnapshotChild(host, widget, snapshot)
        node = LCGNode(snapshot)
        If node = Nil Then Return Nil
        Dim viewport As LCGRect = { X: 0.0, Y: 0.0, W: Math.Ceiling(w * scale), H: Math.Ceiling(h * scale) }
        texture = LCGTexture(LCGRenderer(host), node, CType(viewport, Ptr))
        If texture = Nil Then Return Nil
        data = LCGPNG(texture)
        If data = Nil Then Return Nil
        Dim length As Integer = LCGBytesSize(data)
        Dim png As New Bytes(length)
        png.Append(LCGBytesData(data, Nil), length)
        Return Picture.FromPNG(png)
    Finally
        If data <> Nil Then LCGBytesUnref(data)
        If texture <> Nil Then LCGUnref(texture)
        If node <> Nil Then LCGNodeUnref(node)
        LCGDestroy(host)
        LCGUnref(widget)
        LCGUnref(theme)
        If font <> Nil Then LCGUnref(font)
    End Try
End Function
#End If

